{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alogaritm-home",
  "main": "src/index.js",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": true
  }
}
